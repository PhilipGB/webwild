; Webwild — Godot 4.7.2 .NET project
; Main scene is replaced from the P0 asset preview by the playable title flow in P1.
config_version=5

[application]

config/name="Webwild"
config/description="A child-friendly spider colony adventure in one garden clearing."
run/main_scene="res://scenes/boot/AssetPreview.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://art/ui/icons/web.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Webwild"

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
cancel={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
build_capture={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
build_bridge={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
colony={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194308)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
camera_zoom_in={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":4)]
}
camera_zoom_out={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":5)]
}

[input_devices]

pointing/emulate_touch_from_mouse=false

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Anchors"
3d_physics/layer_4="Interactables"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.576, 0.843, 0.925, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
